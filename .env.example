# Тестовый магазин ЮKassa -> раздел «Интеграция» → «Ключи API».
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ALLOW_LIVE_PAYMENTS=false

# Бот от @BotFather и идентификатор чата (https://api.telegram.org/botТОКЕН_ДЛЯ_БОТА/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BASE_URL=http://127.0.0.1:5000
# Заменить случайной строкой, чтобы сессия не сбрасывалась после перезапуска.
# Получить ключ: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
WORKER_INTERVAL_SECONDS=30
# once: один повтор через сутки, затем пауза. daily: повторы каждые сутки.
RETRY_POLICY=once
